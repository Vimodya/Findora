# Findora — local environment variable template.
#
# Copy this file to `.env` (gitignored, never commit it) and fill in real
# values for your machine. Individual values below are placeholders only —
# no real credentials belong in this file.
#
# ASP.NET Core automatically maps environment variables with a double
# underscore (`__`) into nested configuration keys, so
# `ConnectionStrings__DefaultConnection` overrides
# `ConnectionStrings:DefaultConnection` from appsettings.json without any
# extra wiring.

# --- PostgreSQL (Module 1 — Database Foundation) -----------------------
# Individual parts, useful once Module 22 wires these into docker-compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=findora_dev
POSTGRES_USER=findora
POSTGRES_PASSWORD=changeme

# Full EF Core / Npgsql connection string read directly by Findora.API.
# Keep this in sync with the POSTGRES_* values above.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=findora_dev;Username=findora;Password=changeme

# --- JWT (Module 2 — Authentication & Authorization) --------------------
# SigningKey must be at least 32 bytes/characters — the API fails fast at
# startup if it's missing or too short. Generate your own local value, e.g.:
#   bash/zsh:   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String([byte[]](1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Never reuse this value anywhere real, and never commit a real one.
Jwt__Issuer=Findora.API
Jwt__Audience=Findora.Client
Jwt__SigningKey=REPLACE_WITH_YOUR_OWN_LOCAL_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
